  "line_presets": {
    "thin": {
      "label": "얇은 선",
      "width": "0.12mm",
      "type": "solid",
      "color": "진회색"
    },
    "thick": {
      "label": "굵은 선",
      "width": "0.3mm",
      "type": "solid",
      "color": "진회색"
    },
    "double": {
      "label": "이중 선",
      "width": "0.7mm",
      "type": "double",
      "color": "진회색"
    },
    "dotted": {
      "label": "점선",
      "width": "0.12mm",
      "type": "dot",
      "color": "진회색"
    },
    "none": {
      "label": "선 없음",
      "width": "0.12mm",
      "type": "none",
      "color": "흰색"
    }
  },
  "title_cell": {
    "background_color": "셀배경",
    "text_color": "검정",
    "paragraph_style": "표내용-중간",
    "character_style": "표내용-굵게",
    "borders": {
      "top": "thin",
      "bottom": "thin",
      "left": "none",
      "right": "none",
      "inside_horz": "thin",
      "inside_vert": "thin"
    },
    "border_colors": {
      "top": "기본값",
      "bottom": "기본값",
      "left": "기본값",
      "right": "기본값",
      "inside_horz": "기본값",
      "inside_vert": "기본값"
    }
  },
  "table_margins": {
    "cell_left": "2",
    "cell_right": "2",
    "cell_top": "2",
    "cell_bottom": "2",
    "outside_left": "0",
    "outside_right": "0",
    "outside_top": "0",
    "outside_bottom": "3"
  },
  "markdown_table": {
    "paragraph_style": "표내용-중간"
  },
  "caption_parser": {
    "pattern": "^\\[\\s*(?P<kind>표|그림)(?P<gap>\\s*)(?P<prefix>(?:\\d+(?:\\.\\d+)*\\s*)?-)\\s*(?P<number>\\d+)?\\s*\\]\\s*(?P<title>.*)$",
    "prefix_template": "[{kind}{gap}{prefix}",
    "suffix_template": "] {title}",
    "sample": "[그림 2.4-1] 학사관리 체계 개선 실적"
  },
  "title_number_box": {
    "enabled": true,
    "role": "title_number_box",
    "marker": "{{bufs_title}}",
    "template_file": "templates/대제목_번호박스.hwpx",
    "placeholder_title": "대제목",
    "placeholder_number": "1",
    "outside_margin": {
      "left": 0,
      "right": 0,
      "top": 0,
      "bottom": 850
    },
    "table_style_preset": "thin_all",
    "cells": [
      {
